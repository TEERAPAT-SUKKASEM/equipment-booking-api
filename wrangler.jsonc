{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "equipment-booking-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "send_metrics": false,
  "d1_databases": [
    {
      // The id is the deployed D1 database. "wrangler dev" does not touch it: local data lives in .wrangler/state
      "binding": "DB",
      "database_name": "equipment-booking-db",
      "database_id": "267923b3-f167-4195-95f3-94fef0636fe4"
    }
  ]
}
