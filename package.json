{
  "name": "equipment-booking-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Campus Equipment Booking API (Hono + Cloudflare D1) - midterm practical lab test",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:setup": "wrangler d1 execute equipment-booking-db --local --file=./db/schema.sql",
    "db:reset": "wrangler d1 execute equipment-booking-db --local --file=./db/reset.sql && npm run db:setup",
    "db:setup:remote": "wrangler d1 execute equipment-booking-db --remote --file=./db/schema.sql",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
